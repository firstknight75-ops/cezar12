# ═══════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════
DATABASE_URL=postgresql://cezar12:dev_password_change_in_prod@localhost:5432/cezar12_dev

# ═══════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════
# JWT — Generate with:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# cat private.pem | base64 | tr -d '\n'
# ═══════════════════════════════════════════════════════
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_REFRESH_SECRET=change_this_to_random_256_bit_string

# ═══════════════════════════════════════════════════════
# AI APIS
# ═══════════════════════════════════════════════════════
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ═══════════════════════════════════════════════════════
# STORAGE — MinIO (local) or AWS S3 (prod)
# ═══════════════════════════════════════════════════════
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_NAME=cezar12-dev
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/cezar12-dev

# ═══════════════════════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════════════════════
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@cezar12.com

# ═══════════════════════════════════════════════════════
# APP CONFIG
# ═══════════════════════════════════════════════════════
NODE_ENV=development
API_PORT=3001
WORKER_PORT=3002
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ═══════════════════════════════════════════════════════
# EXTERNAL SERVICES
