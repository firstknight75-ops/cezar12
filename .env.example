# ═══════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════
DATABASE_URL=postgresql://cezar12:dev_password_change_in_prod@localhost:5432/cezar12_dev

# ═══════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════
# JWT — HS256 symmetric secret (min 32 chars in prod)
# Generate: openssl rand -hex 32
# ═══════════════════════════════════════════════════════
JWT_SECRET=change-me-in-production-min-32-chars

# ═══════════════════════════════════════════════════════
# AI APIS
# ═══════════════════════════════════════════════════════
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Feature flag: "anthropic" | "openai" (set via Redis key feature:ai_provider)
AI_PROVIDER_DEFAULT=anthropic

# ═══════════════════════════════════════════════════════
# STORAGE — MinIO (local) or AWS S3 (prod)
# ═══════════════════════════════════════════════════════
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_NAME=cezar12-dev
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/cezar12-dev
# Legacy MinIO vars
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cezar12-dev
MINIO_USE_SSL=false

# ═══════════════════════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════════════════════
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@cezar12.com

# ═══════════════════════════════════════════════════════
# APP CONFIG
# ═══════════════════════════════════════════════════════
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PORT=3001
WORKER_PORT=3002
# Frontend dev server runs on 8080 (Vite default in this project)
FRONTEND_URL=http://localhost:8080
API_URL=http://localhost:3001
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════
# EXTERNAL SERVICES
# ═══════════════════════════════════════════════════════
EXCHANGE_RATE_API_KEY=
REMOVE_BG_API_KEY=

# ═══════════════════════════════════════════════════════
# MONITORING (optional in dev)
# ═══════════════════════════════════════════════════════
SENTRY_DSN=

# ═══════════════════════════════════════════════════════
# VITE (web package) — must be prefixed VITE_ to be
# exposed in the browser bundle. NOT Next.js.
# ═══════════════════════════════════════════════════════
VITE_API_URL=http://localhost:3001/api
