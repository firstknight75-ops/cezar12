# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase / PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/cezar12

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── MinIO / S3 Object Storage ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cezar12
MINIO_USE_SSL=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# ─── AI Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Feature flag: "anthropic" | "openai" (set via Redis key feature:ai_provider)
AI_PROVIDER_DEFAULT=anthropic

# ─── Supabase (web package only) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
