# ═══════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════
DATABASE_URL=postgresql://cezar12:dev_password_change_in_prod@localhost:5432/cezar12_dev

# ═══════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════
# JWT — Generate with:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# cat private.pem | base64 | tr -d '\n'
# ═══════════════════════════════════════════════════════
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_REFRESH_SECRET=change_this_to_random_256_bit_string
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# ═══════════════════════════════════════════════════════
# AI APIS
# ═══════════════════════════════════════════════════════
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Feature flag: "anthropic" | "openai" (set via Redis key feature:ai_provider)
AI_PROVIDER_DEFAULT=anthropic

# ═══════════════════════════════════════════════════════
# STORAGE — MinIO (local) or AWS S3 (prod)
# ═══════════════════════════════════════════════════════
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_NAME=cezar12-dev
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/cezar12-dev
# Legacy MinIO vars
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cezar12-dev
MINIO_USE_SSL=false

# ═══════════════════════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════════════════════
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@cezar12.com

# ═══════════════════════════════════════════════════════
# APP CONFIG
# ═══════════════════════════════════════════════════════
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PORT=3001
WORKER_PORT=3002
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════
# EXTERNAL SERVICES
# ═══════════════════════════════════════════════════════
EXCHANGE_RATE_API_KEY=
REMOVE_BG_API_KEY=

# ═══════════════════════════════════════════════════════
# MONITORING (optional in dev)
# ═══════════════════════════════════════════════════════
SENTRY_DSN=

# ═══════════════════════════════════════════════════════
# NEXT.JS (web package)
# ═══════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
