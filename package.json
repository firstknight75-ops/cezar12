{
  "name": "cezar12",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "cd packages/web && node_modules/.bin/vite --host 0.0.0.0",
    "build": "cd packages/web && node_modules/.bin/vite build",
    "build:dev": "cd packages/web && node_modules/.bin/vite build --mode development",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "rm -rf dist packages/web/dist && pnpm --filter @cezar12/web run clean 2>/dev/null || true",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/api/src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "web:dev": "pnpm --filter @cezar12/web-next dev",
    "web:build": "pnpm --filter @cezar12/web-next build",
    "web:rebuild": "pnpm --filter @cezar12/web-next rebuild",
    "web:fresh": "pnpm --filter @cezar12/web-next fresh",
    "docker:dev": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:clean": "docker-compose down -v"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.31.0",
    "prettier": "^3.4.2",
    "tsx": "^4.11.0",
    "turbo": "^2.3.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
