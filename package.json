{
  "name": "cezar12",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @cezar12/web dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/api/src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "docker:dev": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:clean": "docker-compose down -v"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "drizzle-kit": "^0.22.0",
    "tsx": "^4.11.0",
    "dotenv": "^16.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
